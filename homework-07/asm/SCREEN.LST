				es:byte 
 0000				data ends 
				public render_calendar, write_string, crlf, ren
				der_enter, render_return 
				public before_digits, after_digits, print_unsig
				ned, unsigned_return 
 0000				screen segment para public 'CODE' 
				assume cs:screen,ds:data 
				; Data-segment parameters: selected_year/month,
				 first_day, month_length. 
				; FAR return restores both IP and CS. Preserve 
				all used registers. 
