				; SCREEN is a distinct code segment; imported F
				AR procedures end in RETF. 
				include MACROS.INC 
			     C	; Compile-time expansion; a macro itself has no
				 runtime CALL or return address. 
			     C	; This macro expands to LEA + a real FAR CALL t
				o the output procedure. 
			     C	PRINT_TEXT macro message 
			     C	    lea dx,message 
			     C	    call far ptr write_string 
			     C	endm 
			     C	 
			     C	NEW_LINE macro 
			     C	    call far ptr crlf 
			     C	endm 
			     C	 
			     C	; LOCAL generates unique labels for the two exp
				ansions in MAIN. 
			     C	; Inverted short conditions skip a NEAR JMP, av
				oiding the 8086 Jcc range limit. 
			     C	REQUIRE_RANGE macro value,lower,upper,failure 
			     C	    local lower_ok,range_ok 
			     C	    cmp value,lower 
			     C	    jae short lower_ok 
			     C	    jmp near ptr failure 
			     C	lower_ok: 
			     C	    cmp value,upper 
			     C	    jbe short range_ok 
			     C	    jmp near ptr failure 
			     C	range_ok: 
			     C	endm 
				 
 0000				data segment para public 'DATA' 
				extrn selected_year:word, selected_month:word, 
				first_day:word, month_length:word 
