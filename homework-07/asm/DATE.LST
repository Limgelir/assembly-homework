				; Calendar arithmetic; PUBLIC CORE combines wit
				h MAIN and INPUT at link time. 
 0000				data segment para public 'DATA' 
				extrn month_days:byte 
 0000				data ends 
 0000				core segment para public 'CODE' 
				assume cs:core,ds:data 
				public leap_year, days_in_month, first_weekday,
				 weekday_frame, weekday_return 
				; Register argument AX=year -> AX=0/1; preserve
				 BX/CX/DX. 
 0000				leap_year proc near 
 0000  53			    push bx 
 0001  51			    push cx 
 0002  52			    push dx 
 0003  8B C8			    mov cx,ax 
 0005  BB 0004			    mov bx,4 
 0008  33 D2			    xor dx,dx 
 000A  F7 F3			    div bx 
 000C  0B D2			    or dx,dx 
 000E  75 1F			    jnz not_leap 
 0010  8B C1			    mov ax,cx 
 0012  BB 0064			    mov bx,100 
 0015  33 D2			    xor dx,dx 
 0017  F7 F3			    div bx 
 0019  0B D2			    or dx,dx 
 001B  75 0D			    jnz is_leap 
 001D  8B C1			    mov ax,cx 
 001F  BB 0190			    mov bx,400 
 0022  33 D2			    xor dx,dx 
 0024  F7 F3			    div bx 
 0026  0B D2			    or dx,dx 
 0028  75 05			    jnz not_leap 
 002A				is_leap: 
 002A  B8 0001			    mov ax,1 
 002D  EB 02			    jmp short leap_end 
 002F				not_leap: 
 002F  33 C0			    xor ax,ax 
 0031				leap_end: 
 0031  5A			    pop dx 
 0032  59			    pop cx 
 0033  5B			    pop bx 
 0034  C3			    ret 
 0035				leap_year endp 
				 
				; AX=year, BX=month (1..12) -> AX=28..31. Other
				 registers preserved. 
 0035				days_in_month proc near 
 0035  56			    push si 
 0036  83 FB 02			    cmp bx,2 
 0039  75 08			    jne ordinary_month 
 003B  E8 0000 R		    call leap_year 
 003E  05 001C			    add ax,28 
 0041  EB 09			    jmp short days_end 
