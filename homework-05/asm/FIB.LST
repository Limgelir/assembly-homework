				; Input AX=n (0..100). Return DS:SI -> memo[n],
				 5 little-endian words. 
				; Preserve AX/BX/CX/DX/DI/BP. SI is the return 
				value; flags may change. 
 0075				fib proc near 
 0075  55			    push bp 
 0076  8B EC			    mov bp,sp 
 0078  50			    push ax                            ; Saved 
				n at SS:[BP-2]. 
 0079  53			    push bx 
 007A  51			    push cx 
 007B  52			    push dx 
 007C  57			    push di 
 007D				frame_ready:                           ; 14 byt
				es including near return IP. 
 007D  FF 06 0457 R		    inc calls 
 0081  3B 26 0459 R		    cmp sp,min_sp 
 0085  73 04			    jae depth_recorded 
 0087  89 26 0459 R		    mov min_sp,sp 
 008B				depth_recorded: 
 008B  8B D8			    mov bx,ax 
 008D  80 BF 03F2 R 00		    cmp ready[bx],0 
 0092  75 37			    jne cached 
 0094  48			    dec ax 
 0095  E8 0075 R		    call fib                           ; F(n-1)
				, recursively. 
 0098  56			    push si                            ; Keep i
				ts pointer across next call. 
 0099  8B 46 FE			    mov ax,[bp-2] 
 009C  2D 0002			    sub ax,2 
 009F  E8 0075 R		    call fib                           ; F(n-2)
				; already cached on unwind. 
 00A2  5F			    pop di 
 00A3  8B 46 FE			    mov ax,[bp-2] 
 00A6  BB 000A			    mov bx,10 
 00A9  F7 E3			    mul bx 
 00AB  8D 1E 0000 R		    lea bx,memo 
 00AF  03 D8			    add bx,ax                          ; Destin
				ation = memo + n*10. 
 00B1  B9 0005			    mov cx,5 
 00B4  F8			    clc 
 00B5				add_words: 
 00B5  8B 05			    mov ax,[di] 
 00B7  13 04			    adc ax,[si]                        ; Propag
				ate carry across all 80 bits. 
 00B9  89 07			    mov [bx],ax 
 00BB  46			    inc si                             ; INC an
				d LOOP preserve carry. 
 00BC  46			    inc si 
 00BD  47			    inc di 
 00BE  47			    inc di 
 00BF  43			    inc bx 
 00C0  43			    inc bx 
