				, even when bad cells exist. 
 0034  CD 21			    int 21h 
				 
				; Input DS:SI=current byte, BH=row, BL=column. 
				; Preserve AX/BX/CX/DX/SI; flags may change. Do
				es not modify the table. 
 0036				check_cell proc near 
 0036  50			    push ax 
 0037  53			    push bx 
 0038  51			    push cx 
 0039  52			    push dx 
 003A  56			    push si 
 003B  8A C7			    mov al,bh 
 003D  F6 E3			    mul bl                    ; AX = row * colu
				mn, maximum 81. 
 003F				compare_cell: 
 003F  3A 04			    cmp al,[si]               ; Register-indire
				ct access through DS:SI. 
 0041  74 03			    je cell_done 
 0043  E8 004C R		    call report_error 
 0046				cell_done: 
 0046  5E			    pop si 
 0047  5A			    pop dx 
 0048  59			    pop cx 
 0049  5B			    pop bx 
 004A  58			    pop ax 
 004B  C3			    ret 
 004C				check_cell endp 
				 
				; Report BH BL. Borrow CX to output two spaces,
				 then restore it. 
