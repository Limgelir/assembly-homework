 0088  5A			    pop dx 
 0089  59			    pop cx 
 008A  5B			    pop bx 
 008B  58			    pop ax 
 008C  C3			    ret 
 008D				print_dec endp 
				 
				; Input DL=character. Preserve AX, so DOS AH=02
				h cannot destroy product. 
 008D				put_char proc near 
 008D  50			    push ax 
 008E  B4 02			    mov ah,02h 
 0090  CD 21			    int 21h 
 0092  58			    pop ax 
 0093  C3			    ret 
 0094				put_char endp 
				 
 0094				newline proc near 
 0094  52			    push dx 
 0095  B2 0D			    mov dl,13 
 0097  E8 008D R		    call put_char 
 009A  B2 0A			    mov dl,10 
 009C  E8 008D R		    call put_char 
 009F  5A			    pop dx 
 00A0  C3			    ret 
 00A1				newline endp 
				 
 00A1				end start 
