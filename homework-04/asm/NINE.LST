				; Homework 4: reverse triangular multiplication
				 table, 8086 / DOS. 
				; BH = row (9..1), BL = column (1..row), CX = c
				urrent loop count. 
				.model small 
 0100				.stack 100h 
 0000				.data 
 0000  54 68 65 20 39 6D 75	heading db 'The 9mul9 table:',13,10,'$' 
       6C 39 20 74 61 62 6C	
       65 3A 0D 0A 24		
 0000				.code 
 0000				start: 
 0000  B8 ---- R		    mov ax,@data 
 0003  8E D8			    mov ds,ax 
 0005  8D 16 0000 R		    lea dx,heading 
 0009  B4 09			    mov ah,09h 
 000B  CD 21			    int 21h 
 000D  B7 09			    mov bh,9 
 000F  B9 0009			    mov cx,9 
 0012				row_loop: 
 0012  51			    push cx                   ; Save OUTER loop
				 counter. 
 0013  33 C9			    xor cx,cx 
 0015  8A CF			    mov cl,bh                 ; INNER loop: row
				 cells. 
 0017  B3 01			    mov bl,1 
 0019				column_loop: 
 0019  E8 002D R		    call print_cell           ; Callee preserve
				s main's AX/BX/CX/DX. 
 001C				after_cell: 
 001C  FE C3			    inc bl 
 001E  E2 F9			    loop column_loop 
 0020  E8 0094 R		    call newline 
 0023  59			    pop cx                    ; Restore OUTER l
				oop counter. 
 0024  FE CF			    dec bh 
 0026  E2 EA			    loop row_loop 
 0028				table_done: 
 0028  B8 4C00			    mov ax,4c00h 
 002B  CD 21			    int 21h 
				 
				; Input BH=row, BL=column. Print r*c=product, p
				added to 9 columns 
				; except at the end of a row. Preserve AX/BX/CX
				/DX; flags may change. 
 002D				print_cell proc near 
 002D  50			    push ax 
 002E  53			    push bx 
 002F  51			    push cx 
 0030  52			    push dx 
 0031  8A D7			    mov dl,bh 
 0033  E8 0065 R		    call print_digit 
 0036  B2 2A			    mov dl,'*' 
 0038  E8 008D R		    call put_char 
