 003B  8A D3			    mov dl,bl 
 003D  E8 0065 R		    call print_digit 
 0040  B2 3D			    mov dl,'=' 
 0042  E8 008D R		    call put_char 
 0045  8A C7			    mov al,bh 
 0047  F6 E3			    mul bl                    ; 8-bit unsigned 
				multiply: AX = AL * BL. 
 0049				product_ready:                ; 9*1: AX=0009; 9
				*9: AX=0051. 
 0049  E8 006C R		    call print_dec 
 004C  3A DF			    cmp bl,bh 
 004E  74 10			    je cell_done              ; No trailing spa
				ces at end of row. 
 0050  B9 0004			    mov cx,4                  ; Single-digit pr
				oduct: 5 chars + 4 spaces. 
 0053  3D 000A			    cmp ax,10 
 0056  72 01			    jb pad_cell 
 0058  49			    dec cx                    ; Two-digit produ
				ct: 6 chars + 3 spaces. 
 0059				pad_cell: 
 0059  B2 20			    mov dl,' ' 
 005B				pad_loop: 
 005B  E8 008D R		    call put_char 
 005E  E2 FB			    loop pad_loop             ; Reuses main's C
				X, saved on entry. 
 0060				cell_done: 
 0060  5A			    pop dx 
 0061  59			    pop cx 
 0062  5B			    pop bx 
 0063  58			    pop ax 
 0064				cell_return: 
 0064  C3			    ret                       ; Pop return IP p
				ushed by near CALL. 
 0065				print_cell endp 
				 
				; Input DL=0..9; output a digit. Changes DL; pr
				eserves AX. 
 0065				print_digit proc near 
 0065  80 C2 30			    add dl,'0' 
 0068  E8 008D R		    call put_char 
 006B  C3			    ret 
 006C				print_digit endp 
				 
				; Print unsigned AX in decimal (also handles 0)
				. Preserve AX/BX/CX/DX. 
 006C				print_dec proc near 
 006C  50			    push ax 
 006D  53			    push bx 
 006E  51			    push cx 
 006F  52			    push dx 
 0070  BB 000A			    mov bx,10 
 0073  33 C9			    xor cx,cx 
 0075				decimal_split: 
 0075  33 D2			    xor dx,dx                 ; DIV uses DX:AX 
