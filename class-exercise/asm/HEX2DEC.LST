 0039				parse_digit: 
 0039  8A 04			    mov al,[si] 
 003B  3C 30			    cmp al,'0' 
 003D  72 E8			    jb bad_input 
 003F  3C 39			    cmp al,'9' 
 0041  76 0F			    jbe numeric_digit 
 0043  24 DF			    and al,0dfh               ; Lowercase a-f -
				> uppercase A-F. 
 0045  3C 41			    cmp al,'A' 
 0047  72 DE			    jb bad_input 
 0049  3C 46			    cmp al,'F' 
 004B  77 DA			    ja bad_input 
 004D  2C 37			    sub al,'A'-10 
 004F  EB 03 90			    jmp accumulate 
 0052				numeric_digit: 
 0052  2C 30			    sub al,'0' 
 0054				accumulate: 
 0054  32 E4			    xor ah,ah 
 0056  D1 E3			    shl bx,1                  ; Four one-bit sh
				ifts are valid on 8086. 
 0058  D1 E3			    shl bx,1 
 005A  D1 E3			    shl bx,1 
 005C  D1 E3			    shl bx,1 
 005E  03 D8			    add bx,ax                 ; value = value *
				 16 + digit. 
 0060  46			    inc si 
 0061  E2 D6			    loop parse_digit 
 0063  8B C3			    mov ax,bx 
 0065  8D 16 002A R		    lea dx,answer 
 0069  E8 0099 R		    call puts 
 006C  E8 0077 R		    call print_dec 
 006F  E8 00A0 R		    call newline 
 0072  B8 4C00			    mov ax,4c00h 
 0075  CD 21			    int 21h 
				 
				; Print unsigned AX (0..65535) in decimal; pres
				erve AX/BX/CX/DX. 
 0077				print_dec proc near 
 0077  50			    push ax 
 0078  53			    push bx 
 0079  51			    push cx 
 007A  52			    push dx 
 007B  BB 000A			    mov bx,10 
 007E  33 C9			    xor cx,cx 
 0080				decimal_split: 
 0080  33 D2			    xor dx,dx                 ; DIV uses DX:AX,
				 not AX alone. 
 0082  F7 F3			    div bx 
 0084  52			    push dx                   ; Save remainder,
				 least significant first. 
 0085  41			    inc cx 
 0086  0B C0			    or ax,ax 
 0088  75 F6			    jnz decimal_split 
 008A				decimal_write: 
Microsoft (R) Macro Assembler Version 5.00                  10/21/26 12:58:25
                                                             Page     1-3


 008A  5A			    pop dx                    ; Reverse order g
				ives most significant first. 
 008B  80 C2 30			    add dl,'0' 
 008E  B4 02			    mov ah,02h 
 0090  CD 21			    int 21h 
 0092  E2 F6			    loop decimal_write 
 0094  5A			    pop dx 
 0095  59			    pop cx 
 0096  5B			    pop bx 
 0097  58			    pop ax 
 0098  C3			    ret 
 0099				print_dec endp 
				 
				; Print the '$'-terminated string at DS:DX; pre
				serve AX. 
 0099				puts proc near 
 0099  50			    push ax 
 009A  B4 09			    mov ah,09h 
 009C  CD 21			    int 21h 
 009E  58			    pop ax 
 009F  C3			    ret 
 00A0				puts endp 
				 
 00A0				newline proc near 
 00A0  50			    push ax 
 00A1  52			    push dx 
 00A2  B2 0D			    mov dl,0dh 
 00A4  B4 02			    mov ah,02h 
 00A6  CD 21			    int 21h 
 00A8  B2 0A			    mov dl,0ah 
 00AA  B4 02			    mov ah,02h 
 00AC  CD 21			    int 21h 
 00AE  5A			    pop dx 
 00AF  58			    pop ax 
 00B0  C3			    ret 
