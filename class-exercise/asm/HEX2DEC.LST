				; Classroom exercise: 1-2 hexadecimal digits ->
				 unsigned decimal. 
				.model small 
 0100				.stack 100h 
 0000				.data 
 0000  50 6C 65 61 73 65 20	prompt db 'Please input a Hex number (1-2 digit
				s):',13,10,'$' 
       69 6E 70 75 74 20 61	
       20 48 65 78 20 6E 75	
       6D 62 65 72 20 28 31	
       2D 32 20 64 69 67 69	
       74 73 29 3A 0D 0A 24	
 002A  54 68 65 20 44 65 63	answer db 'The Dec number:',13,10,'$' 
       20 6E 75 6D 62 65 72	
       3A 0D 0A 24		
 003C  45 72 72 6F 72 3A 20	error_msg db 'Error: enter 1-2 hex digits (0-9,
				 A-F or a-f).',13,10,'$' 
       65 6E 74 65 72 20 31	
       2D 32 20 68 65 78 20	
       64 69 67 69 74 73 20	
       28 30 2D 39 2C 20 41	
       2D 46 20 6F 72 20 61	
       2D 66 29 2E 0D 0A 24	
 006D  40 00			input_buf db 64,0,64 dup (0)  ; Max includes CR
				; count excludes CR. 
       0040[			
	   00			
			 ]	
				
 0000				.code 
 0000				start: 
 0000  B8 ---- R		    mov ax,@data 
 0003  8E D8			    mov ds,ax 
 0005  8D 16 0000 R		    lea dx,prompt 
 0009  E8 0099 R		    call puts 
 000C  8D 16 006D R		    lea dx,input_buf 
 0010  B4 0A			    mov ah,0ah                ; Buffered input;
				 supports Backspace and Enter. 
 0012  CD 21			    int 21h 
 0014  E8 00A0 R		    call newline 
 0017  33 C9			    xor cx,cx 
 0019  8A 0E 006E R		    mov cl,input_buf[1] 
 001D  E3 08			    jcxz bad_input 
 001F  80 F9 02			    cmp cl,2 
 0022  77 03			    ja bad_input 
 0024  EB 0D 90			    jmp parse_start 
 0027				bad_input: 
 0027  8D 16 003C R		    lea dx,error_msg 
 002B  E8 0099 R		    call puts 
 002E  B8 4C01			    mov ax,4c01h 
 0031  CD 21			    int 21h 
 0033				parse_start: 
 0033  8D 36 006F R		    lea si,input_buf[2] 
 0037  33 DB			    xor bx,bx 
