				; Extra classroom exercise: unsigned decimal 0.
				.65535 -> hexadecimal. 
				.model small 
 0100				.stack 100h 
 0000				.data 
 0000  50 6C 65 61 73 65 20	prompt db 'Please input a Dec number (0-65535):
				',13,10,'$' 
       69 6E 70 75 74 20 61	
       20 44 65 63 20 6E 75	
       6D 62 65 72 20 28 30	
       2D 36 35 35 33 35 29	
       3A 0D 0A 24		
 0027  54 68 65 20 48 65 78	answer db 'The Hex number:',13,10,'$' 
       20 6E 75 6D 62 65 72	
       3A 0D 0A 24		
 0039  45 72 72 6F 72 3A 20	error_msg db 'Error: enter 1-5 decimal digits i
				n 0..65535.',13,10,'$' 
       65 6E 74 65 72 20 31	
       2D 35 20 64 65 63 69	
       6D 61 6C 20 64 69 67	
       69 74 73 20 69 6E 20	
       30 2E 2E 36 35 35 33	
       35 2E 0D 0A 24		
 0068  40 00			input_buf db 64,0,64 dup (0) 
       0040[			
	   00			
			 ]	
				
