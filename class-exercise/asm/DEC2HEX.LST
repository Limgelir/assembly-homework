				; Print unsigned AX in uppercase hex, no prefix
				 or unnecessary leading zero. 
 006E				print_hex proc near 
 006E  50			    push ax 
 006F  53			    push bx 
 0070  51			    push cx 
 0071  52			    push dx 
 0072  BB 0010			    mov bx,16 
 0075  33 C9			    xor cx,cx 
 0077				hex_split: 
