				; Homework 3: accumulate in a word on the stack
				, addressed by SS:BP. 
				.model small 
 0100				.stack 100h 
 0000				.code 
 0000				start: 
 0000  55			    push bp                   ; Save caller's B
				P. 
 0001  33 C0			    xor ax,ax 
 0003  50			    push ax                   ; Allocate and in
				itialize a 16-bit local sum. 
 0004  8B EC			    mov bp,sp                 ; [BP] uses SS by
				 default on 8086. 
 0006  BB 0001			    mov bx,1 
 0009  B9 0064			    mov cx,100 
 000C				sum_loop: 
 000C  01 5E 00			    add word ptr [bp],bx      ; Update the stac
				k variable on every iteration. 
 000F  43			    inc bx 
 0010  E2 FA			    loop sum_loop 
 0012				sum_done:                     ; SS:BP contains 
				BA 13; SP=00FCh. 
 0012  8B 46 00			    mov ax,[bp] 
 0015  83 C4 02			    add sp,2                  ; Release exactly
				 the local word. 
 0018  5D			    pop bp                    ; Restore BP; SP 
				is now 0100h again. 
 0019				stack_restored: 
 0019  E8 0024 R		    call print_dec 
 001C  E8 004D R		    call newline 
 001F  B8 4C00			    mov ax,4c00h 
 0022  CD 21			    int 21h 
				 
				; Print unsigned AX (0..65535) in decimal; pres
				erve AX/BX/CX/DX. 
 0024				print_dec proc near 
 0024  50			    push ax 
 0025  53			    push bx 
 0026  51			    push cx 
 0027  52			    push dx 
 0028  BB 000A			    mov bx,10 
 002B  33 C9			    xor cx,cx 
 002D				decimal_split: 
 002D  33 D2			    xor dx,dx                 ; DIV uses DX:AX,
				 not AX alone. 
 002F  F7 F3			    div bx 
 0031  52			    push dx                   ; Save remainder,
				 least significant first. 
 0032  41			    inc cx 
 0033  0B C0			    or ax,ax 
 0035  75 F6			    jnz decimal_split 
 0037				decimal_write: 
 0037  5A			    pop dx                    ; Reverse order g
				ives most significant first. 
