				; Print unsigned AX (0..65535) in decimal; pres
				erve AX/BX/CX/DX. 
 0084				print_dec proc near 
 0084  50			    push ax 
 0085  53			    push bx 
 0086  51			    push cx 
 0087  52			    push dx 
 0088  BB 000A			    mov bx,10 
