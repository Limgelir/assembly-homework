				; Homework 3: accumulate 1+2+...+100 in registe
				r AX. 
				.model small 
 0100				.stack 100h 
 0000				.code 
 0000				start: 
 0000  33 C0			    xor ax,ax 
 0002  BB 0001			    mov bx,1 
 0005  B9 0064			    mov cx,100 
 0008				sum_loop: 
 0008  03 C3			    add ax,bx 
 000A  43			    inc bx 
 000B  E2 FB			    loop sum_loop 
 000D				sum_done:                     ; AX=13BAh=5050, 
				BX=101, CX=0. 
 000D  E8 0018 R		    call print_dec 
 0010  E8 0041 R		    call newline 
 0013  B8 4C00			    mov ax,4c00h 
 0016  CD 21			    int 21h 
				 
				; Print unsigned AX (0..65535) in decimal; pres
				erve AX/BX/CX/DX. 
 0018				print_dec proc near 
 0018  50			    push ax 
 0019  53			    push bx 
 001A  51			    push cx 
 001B  52			    push dx 
 001C  BB 000A			    mov bx,10 
 001F  33 C9			    xor cx,cx 
 0021				decimal_split: 
 0021  33 D2			    xor dx,dx                 ; DIV uses DX:AX,
				 not AX alone. 
 0023  F7 F3			    div bx 
 0025  52			    push dx                   ; Save remainder,
				 least significant first. 
 0026  41			    inc cx 
 0027  0B C0			    or ax,ax 
 0029  75 F6			    jnz decimal_split 
 002B				decimal_write: 
 002B  5A			    pop dx                    ; Reverse order g
				ives most significant first. 
 002C  80 C2 30			    add dl,'0' 
 002F  B4 02			    mov ah,02h 
 0031  CD 21			    int 21h 
 0033  E2 F6			    loop decimal_write 
 0035  5A			    pop dx 
 0036  59			    pop cx 
 0037  5B			    pop bx 
 0038  58			    pop ax 
 0039  C3			    ret 
 003A				print_dec endp 
				 
