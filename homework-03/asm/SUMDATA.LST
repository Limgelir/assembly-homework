				; Print unsigned AX (0..65535) in decimal; pres
				erve AX/BX/CX/DX. 
 0026				print_dec proc near 
 0026  50			    push ax 
 0027  53			    push bx 
 0028  51			    push cx 
 0029  52			    push dx 
 002A  BB 000A			    mov bx,10 
 002D  33 C9			    xor cx,cx 
 002F				decimal_split: 
 002F  33 D2			    xor dx,dx                 ; DIV uses DX:AX,
				 not AX alone. 
 0031  F7 F3			    div bx 
 0033  52			    push dx                   ; Save remainder,
				 least significant first. 
 0034  41			    inc cx 
 0035  0B C0			    or ax,ax 
 0037  75 F6			    jnz decimal_split 
 0039				decimal_write: 
 0039  5A			    pop dx                    ; Reverse order g
				ives most significant first. 
 003A  80 C2 30			    add dl,'0' 
 003D  B4 02			    mov ah,02h 
 003F  CD 21			    int 21h 
 0041  E2 F6			    loop decimal_write 
 0043  5A			    pop dx 
 0044  59			    pop cx 
